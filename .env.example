# ============ DATABASE ============
DATABASE_URL=postgresql://runquest:runquest@postgres:5432/runquest?schema=public

# ============ AUTH ============
JWT_ACCESS_SECRET=change-me-prod-32-chars-minimum-please-do-it
JWT_REFRESH_SECRET=change-me-prod-32-chars-minimum-please-do-it-2
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# Google OAuth — https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://runquest.veloxisit.com.br/api/auth/google/callback

# ============ MERCADO PAGO (apenas API key server-side) ============
MP_ACCESS_TOKEN=            # access token do painel do Mercado Pago
MP_WEBHOOK_SECRET=         # segredo HMAC do painel do MP
MP_PLAN_MONTHLY_ID=
MP_PLAN_YEARLY_ID=
MP_BACK_URL=https://runquest.veloxisit.com.br/app/premium/return

# ============ STRIPE (billing internacional multi-moeda) ============
# Opcional: se não configurado, o app sobe normalmente (mercados BRL via Mercado Pago)
# e só falha se alguém tentar checkout em moeda internacional (USD/EUR/GBP/CAD/AUD/MXN).
STRIPE_SECRET_KEY=         # secret key do painel do Stripe
STRIPE_WEBHOOK_SECRET=     # signing secret do webhook do Stripe
STRIPE_SUCCESS_URL=https://runquest.veloxisit.com.br/app?premium=success
STRIPE_CANCEL_URL=https://runquest.veloxisit.com.br/pricing?canceled=1
APP_URL=https://runquest.veloxisit.com.br

# ============ HOTMART (billing BR — link hospedado) ============
# Opcional (o app sobe sem). Se usar, HOTMART_HOTTOK é OBRIGATÓRIO em produção:
# sem ele o webhook REJEITA tudo (o pagante nunca vira Premium).
HOTMART_HOTTOK=
HOTMART_OFFER_MONTHLY_URL=
HOTMART_OFFER_YEARLY_URL=
HOTMART_OFFER_MONTHLY_CODE=
HOTMART_OFFER_YEARLY_CODE=

# ============ CAKTO (billing BR — link hospedado) ============
# CAKTO_WEBHOOK_SECRET (ou CAKTO_TOKEN) valida o webhook — sem ele, em produção,
# o webhook rejeita e o pagante não vira Premium.
CAKTO_WEBHOOK_SECRET=
CAKTO_TOKEN=
CAKTO_OFFER_MONTHLY_URL=
CAKTO_OFFER_YEARLY_URL=
CAKTO_OFFER_MONTHLY_CODE=
CAKTO_OFFER_YEARLY_CODE=

# Seleciona o provedor BR de checkout: mercadopago (padrão) | hotmart | cakto
BR_BILLING_PROVIDER=mercadopago

# ============ WEB PUSH (VAPID) ============
# Sem estas chaves o push (kudos/comentários/resumo semanal) não funciona.
# Gerar: npx web-push generate-vapid-keys
VAPID_PUBLIC=
VAPID_PRIVATE=
VAPID_SUBJECT=mailto:contato@veloxisit.com.br

# ============ IA (Personal Trainer / Coach — opcional, fallback multi-chave) ============
# Sem nenhuma chave, os recursos de IA respondem "indisponível" (o app sobe normal).
# Rotação: GEMINI_API_KEY, GEMINI_API_KEY_2 … _6; SAMBANOVA_API_KEY, _2 … _8.
GEMINI_API_KEY=
SAMBANOVA_API_KEY=

# ============ CRON (jobs agendados protegidos) ============
# Segredo exigido no header dos endpoints de cron (ex.: sync Strava agendado).
CRON_SECRET=

# ============ STRAVA ============
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_CALLBACK_URL=https://runquest.veloxisit.com.br/api/strava/callback
# Token de verificação da subscription de webhook do Strava (você escolhe o valor).
STRAVA_WEBHOOK_VERIFY_TOKEN=

# Chave AES-256-GCM (32 bytes hex = 64 chars) p/ criptografar Strava tokens at rest
# Gerar: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

# ============ APP ============
APP_BASE_URL=https://runquest.veloxisit.com.br
API_BASE_URL=https://runquest.veloxisit.com.br/api
WEB_PORT=3000
API_PORT=4000
NODE_ENV=production

# ============ NEXT (público) ============
NEXT_PUBLIC_API_URL=https://runquest.veloxisit.com.br/api
NEXT_PUBLIC_APP_NAME=RunQuest

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String       @id @default(uuid()) @db.Uuid
  email         String       @unique
  passwordHash  String?
  googleId      String?      @unique
  displayName   String
  avatarUrl     String?
  emailVerified Boolean      @default(false)
  isOwner       Boolean      @default(false)
  isPremium     Boolean      @default(false)
  premiumUntil  DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  xp            Int          @default(0)
  level         Int          @default(1)
  runCoins      Int          @default(0)
  streakDays    Int          @default(0)
  lastRunAt     DateTime?
  refreshTokens RefreshToken[]
  subscription  Subscription?
  payments      Payment[]
  runs          Run[]
  stravaToken   StravaToken?
  missionProgress MissionProgress[]
  territories     Territory[]

  @@index([email])
}

model Mission {
  id          String     @id @default(uuid()) @db.Uuid
  code        String     @unique
  title       String
  description String
  type        MissionType @default(STANDARD)
  scope       MissionScope
  goalKind    String
  goalValue   Float
  xpReward    Int
  coinReward  Int
  premiumOnly Boolean    @default(false)
  startsAt    DateTime?
  endsAt      DateTime?
  createdAt   DateTime   @default(now())
  progress    MissionProgress[]
}

enum MissionScope { DAILY WEEKLY EVENT }
enum MissionType  { STANDARD CHALLENGE AI_GENERATED }

model MissionProgress {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  missionId   String   @db.Uuid
  mission     Mission  @relation(fields: [missionId], references: [id], onDelete: Cascade)
  progress    Float    @default(0)
  completed   Boolean  @default(false)
  claimed     Boolean  @default(false)
  completedAt DateTime?
  claimedAt   DateTime?
  assignedAt  DateTime @default(now())

  @@unique([userId, missionId])
  @@index([userId])
}

model Territory {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  h3Index     String
  visits      Int      @default(1)
  capturedAt  DateTime?
  expiresAt   DateTime
  lastVisitAt DateTime @default(now())

  @@unique([userId, h3Index])
  @@index([h3Index])
  @@index([userId])
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  jti       String   @unique
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  revokedAt DateTime?
  expiresAt DateTime
  createdAt DateTime @default(now())
  userAgent String?
  ip        String?

  @@index([userId])
  @@index([jti])
}

model Subscription {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @unique @db.Uuid
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mpPreapprovalId String   @unique
  plan            SubPlan
  status          String
  startedAt       DateTime @default(now())
  nextPaymentAt   DateTime?
  cancelledAt     DateTime?
  updatedAt       DateTime @updatedAt
}

enum SubPlan {
  MONTHLY
  YEARLY
}

model Payment {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mpPaymentId String   @unique
  amount      Decimal  @db.Decimal(10, 2)
  currency    String   @default("BRL")
  status      String
  paidAt      DateTime?
  createdAt   DateTime @default(now())

  @@index([userId])
}

model Run {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @db.Uuid
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  startedAt       DateTime
  endedAt         DateTime
  distanceMeters  Float
  durationSec     Int
  avgPaceSecPerKm Int
  pointsGeoJson   Json
  source          String   @default("GPS")
  opId            String?  @unique
  stravaActivityId BigInt? @unique
  stravaUploadId  BigInt?
  createdAt       DateTime @default(now())
  workoutSession  WorkoutSession?

  @@index([userId, startedAt(sort: Desc)])
}

model StravaToken {
  userId         String   @id @db.Uuid
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  athleteId      BigInt
  accessTokenEnc String   // base64(iv:cipher:tag), criptografado AES-256-GCM
  refreshTokenEnc String  // idem
  expiresAt      DateTime
  scope          String   @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([athleteId])
}

model Workout {
  id          String           @id @default(uuid()) @db.Uuid
  userId      String?          @db.Uuid
  name        String
  description String?
  type        WorkoutType      @default(INTERVALS)
  totalDurationSec Int         @default(0)
  totalDistanceM   Float       @default(0)
  isTemplate  Boolean          @default(false)
  segments    WorkoutSegment[]
  sessions    WorkoutSession[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([userId])
}

enum WorkoutType {
  INTERVALS
  TEMPO
  LONG_RUN
  EASY
  RECOVERY
  RACE
  CUSTOM
}

model WorkoutSegment {
  id          String        @id @default(uuid()) @db.Uuid
  workoutId   String        @db.Uuid
  workout     Workout       @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  order       Int
  kind        SegmentKind
  durationSec Int?
  distanceM   Float?
  targetPaceSecPerKm Int?
  repeats     Int           @default(1)
  notes       String?

  @@unique([workoutId, order])
}

enum SegmentKind {
  WARMUP
  INTERVAL_FAST
  INTERVAL_SLOW
  TEMPO
  EASY
  COOLDOWN
  REST
  CUSTOM
}

model WorkoutSession {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @db.Uuid
  workoutId     String   @db.Uuid
  workout       Workout  @relation(fields: [workoutId], references: [id])
  runId         String?  @unique @db.Uuid
  run           Run?     @relation(fields: [runId], references: [id])
  startedAt     DateTime
  completedAt   DateTime?
  segmentsDone  Int      @default(0)
  notes         String?

  @@index([userId, startedAt(sort: Desc)])
}

model TrainingPlan {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  name        String
  goal        String
  weeks       Int
  startDate   DateTime
  active      Boolean  @default(true)
  scheduledWorkouts Json   @default("[]")
  createdAt   DateTime @default(now())

  @@index([userId])
}

model WebhookEvent {
  id         String   @id @default(uuid()) @db.Uuid
  provider   String
  externalId String
  payload    Json
  processedAt DateTime?
  createdAt  DateTime @default(now())

  @@unique([provider, externalId])
}

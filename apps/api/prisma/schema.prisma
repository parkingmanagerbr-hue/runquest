generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String       @id @default(uuid()) @db.Uuid
  email         String       @unique
  passwordHash  String?
  googleId      String?      @unique
  displayName   String
  avatarUrl     String?
  emailVerified Boolean      @default(false)
  isOwner       Boolean      @default(false)
  isPremium     Boolean      @default(false)
  premiumUntil  DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  xp                    Int      @default(0)
  level                 Int      @default(1)
  runCoins              Int      @default(0)
  streakDays            Int      @default(0)
  longestStreak         Int      @default(0)
  lastRunAt             DateTime?
  lastDailyClaimAt      DateTime?
  totalDistanceM        Float    @default(0)
  totalRuns             Int      @default(0)
  selectedAvatar        String?
  selectedTerritoryColor String? @default("#A8FF3E")
  weightKg              Float?
  heightCm              Int?
  birthDate             DateTime? @db.Date
  units                 String   @default("metric")
  audioCoachEnabled     Boolean  @default(true)
  audioCoachIntervalKm  Int      @default(1)
  pushSubscription      Json?
  goals                 Goal[]
  kudos                 Kudo[]
  comments              RunComment[]
  notifications         Notification[]
  badges                UserBadge[]
  items                 UserItem[]
  followers             Follow[] @relation("FollowingUser")
  following             Follow[] @relation("FollowerUser")
  refreshTokens RefreshToken[]
  subscription  Subscription?
  payments      Payment[]
  runs          Run[]
  stravaToken   StravaToken?
  missionProgress MissionProgress[]
  territories     Territory[]

  @@index([email])
}

model Mission {
  id          String     @id @default(uuid()) @db.Uuid
  code        String     @unique
  title       String
  description String
  type        MissionType @default(STANDARD)
  scope       MissionScope
  goalKind    String
  goalValue   Float
  xpReward    Int
  coinReward  Int
  premiumOnly Boolean    @default(false)
  startsAt    DateTime?
  endsAt      DateTime?
  createdAt   DateTime   @default(now())
  progress    MissionProgress[]
}

enum MissionScope {
  DAILY
  WEEKLY
  EVENT
}

enum MissionType {
  STANDARD
  CHALLENGE
  AI_GENERATED
}

model MissionProgress {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  missionId   String   @db.Uuid
  mission     Mission  @relation(fields: [missionId], references: [id], onDelete: Cascade)
  progress    Float    @default(0)
  completed   Boolean  @default(false)
  claimed     Boolean  @default(false)
  completedAt DateTime?
  claimedAt   DateTime?
  assignedAt  DateTime @default(now())

  @@unique([userId, missionId])
  @@index([userId])
}

model Territory {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  h3Index     String
  visits      Int      @default(1)
  capturedAt  DateTime?
  expiresAt   DateTime
  lastVisitAt DateTime @default(now())

  @@unique([userId, h3Index])
  @@index([h3Index])
  @@index([userId])
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  jti       String   @unique
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  revokedAt DateTime?
  expiresAt DateTime
  createdAt DateTime @default(now())
  userAgent String?
  ip        String?

  @@index([userId])
  @@index([jti])
}

model Subscription {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @unique @db.Uuid
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mpPreapprovalId String   @unique
  plan            SubPlan
  status          String
  startedAt       DateTime @default(now())
  nextPaymentAt   DateTime?
  cancelledAt     DateTime?
  updatedAt       DateTime @updatedAt
}

enum SubPlan {
  MONTHLY
  YEARLY
}

model Payment {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mpPaymentId String   @unique
  amount      Decimal  @db.Decimal(10, 2)
  currency    String   @default("BRL")
  status      String
  paidAt      DateTime?
  createdAt   DateTime @default(now())

  @@index([userId])
}

model Run {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @db.Uuid
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  startedAt       DateTime
  endedAt         DateTime
  distanceMeters  Float
  durationSec     Int
  avgPaceSecPerKm Int
  pointsGeoJson   Json
  source          String   @default("GPS")
  opId            String?  @unique
  stravaActivityId BigInt? @unique
  stravaUploadId  BigInt?
  createdAt       DateTime @default(now())
  workoutSession  WorkoutSession?
  kudos           Kudo[]
  comments        RunComment[]

  @@index([userId, startedAt(sort: Desc)])
}

model StravaToken {
  userId         String   @id @db.Uuid
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  athleteId      BigInt
  accessTokenEnc String   // base64(iv:cipher:tag), criptografado AES-256-GCM
  refreshTokenEnc String  // idem
  expiresAt      DateTime
  scope          String   @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([athleteId])
}

model Workout {
  id          String           @id @default(uuid()) @db.Uuid
  userId      String?          @db.Uuid
  name        String
  description String?
  type        WorkoutType      @default(INTERVALS)
  totalDurationSec Int         @default(0)
  totalDistanceM   Float       @default(0)
  isTemplate  Boolean          @default(false)
  segments    WorkoutSegment[]
  sessions    WorkoutSession[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([userId])
}

enum WorkoutType {
  INTERVALS
  TEMPO
  LONG_RUN
  EASY
  RECOVERY
  RACE
  CUSTOM
}

model WorkoutSegment {
  id          String        @id @default(uuid()) @db.Uuid
  workoutId   String        @db.Uuid
  workout     Workout       @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  order       Int
  kind        SegmentKind
  durationSec Int?
  distanceM   Float?
  targetPaceSecPerKm Int?
  repeats     Int           @default(1)
  notes       String?

  @@unique([workoutId, order])
}

enum SegmentKind {
  WARMUP
  INTERVAL_FAST
  INTERVAL_SLOW
  TEMPO
  EASY
  COOLDOWN
  REST
  CUSTOM
}

model WorkoutSession {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @db.Uuid
  workoutId     String   @db.Uuid
  workout       Workout  @relation(fields: [workoutId], references: [id])
  runId         String?  @unique @db.Uuid
  run           Run?     @relation(fields: [runId], references: [id])
  startedAt     DateTime
  completedAt   DateTime?
  segmentsDone  Int      @default(0)
  notes         String?

  @@index([userId, startedAt(sort: Desc)])
}

model TrainingPlan {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  name        String
  goal        String
  weeks       Int
  startDate   DateTime
  active      Boolean  @default(true)
  scheduledWorkouts Json   @default("[]")
  createdAt   DateTime @default(now())

  @@index([userId])
}

model Badge {
  id              String   @id @default(uuid()) @db.Uuid
  code            String   @unique
  title           String
  description     String
  icon            String
  tier            String   @default("bronze")
  requirementKind String
  requirementValue Float   @default(0)
  xpReward        Int      @default(0)
  coinReward      Int      @default(0)
  order           Int      @default(0)
  users           UserBadge[]
}

model UserBadge {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badgeId   String   @db.Uuid
  badge     Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  unlockedAt DateTime @default(now())
  @@unique([userId, badgeId])
  @@index([userId])
}

model CosmeticItem {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique
  name        String
  description String?
  kind        String
  value       String
  price       Int
  icon        String?
  premiumOnly Boolean @default(false)
  rarity      String  @default("common")
  users       UserItem[]
}

model UserItem {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemId      String   @db.Uuid
  item        CosmeticItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  purchasedAt DateTime @default(now())
  @@unique([userId, itemId])
  @@index([userId])
}

model Follow {
  id          String   @id @default(uuid()) @db.Uuid
  followerId  String   @db.Uuid
  follower    User     @relation("FollowerUser", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String   @db.Uuid
  following   User     @relation("FollowingUser", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  @@unique([followerId, followingId])
  @@index([followingId])
}

model Goal {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind        String
  period      String
  target      Float
  progress    Float    @default(0)
  windowStart DateTime
  windowEnd   DateTime
  completed   Boolean  @default(false)
  completedAt DateTime?
  createdAt   DateTime @default(now())
  @@index([userId, windowEnd])
}

model Kudo {
  id        String   @id @default(uuid()) @db.Uuid
  runId     String   @db.Uuid
  run       Run      @relation(fields: [runId], references: [id], onDelete: Cascade)
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@unique([runId, userId])
  @@index([runId])
  @@index([userId])
}

model RunComment {
  id        String   @id @default(uuid()) @db.Uuid
  runId     String   @db.Uuid
  run       Run      @relation(fields: [runId], references: [id], onDelete: Cascade)
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  text      String
  createdAt DateTime @default(now())
  @@index([runId])
}

model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String?
  data      Json?
  readAt    DateTime?
  createdAt DateTime @default(now())
  @@index([userId, createdAt])
}

model WebhookEvent {
  id         String   @id @default(uuid()) @db.Uuid
  provider   String
  externalId String
  payload    Json
  processedAt DateTime?
  createdAt  DateTime @default(now())

  @@unique([provider, externalId])
}

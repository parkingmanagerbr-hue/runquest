{
  "name": "runquest",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @runquest/api test:e2e",
    "lint": "pnpm -r lint",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\""
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "typescript": "^5.5.4"
  },
  "pnpm": {
    "overrides": {
      "multer@<2.1.0": ">=2.1.0",
      "serialize-javascript@<6.0.2": ">=6.0.2",
      "brace-expansion@>=2.0.0 <2.1.2": ">=2.1.2 <3",
      "brace-expansion@<1.1.16": ">=1.1.16 <2",
      "postcss@<8.5.10": ">=8.5.10"
    }
  }
}
